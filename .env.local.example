# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend - Email (Required for emailing PDF reports and password reset)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional: must be on your verified Resend domain for arbitrary recipients (Gmail, etc.).
# If unset, the app defaults to Pre Delivery <noreply@<host>> from NEXT_PUBLIC_APP_URL or NEXTAUTH_URL
# (e.g. https://www.predelivery.ai → noreply@predelivery.ai). Localhost cannot auto-default.
# RESEND_FROM_EMAIL=Pre Delivery <noreply@predelivery.ai>
# Local/dev only: Resend sandbox sender — can only deliver to your Resend account email.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: inbox for /contact form (defaults to info@predelivery.ai)
# CONTACT_INBOX_EMAIL=info@predelivery.ai

# JWT secret for auth cookies (change in production)
JWT_SECRET=your-secret-key-change-in-production

# Cron / scheduled jobs — required for POST /api/compliance/retention (min 16 chars)
# CRON_SECRET=generate-a-long-random-secret-here

# Admin MFA: when true, admins must complete TOTP setup/verify at login
# ENFORCE_ADMIN_MFA=true

# OAuth SSO (see docs/OAUTH_SETUP.md) — redirect: {APP_URL}/api/auth/oauth/{google|microsoft}/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common

# Upload malware scan (VirusTotal) — set UPLOAD_MALWARE_SCAN=true to block uploads when scan fails
# VIRUSTOTAL_API_KEY=
# UPLOAD_MALWARE_SCAN=true

# AWS Sydney — private uploads (see infra/terraform)
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=predelivery-uploads-dev-ACCOUNT_ID

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Supabase Storage bucket name (default: inspections)
# SUPABASE_STORAGE_BUCKET=inspections

# OpenAI — voice note polish + AI damage detection (when Ravin is not configured)
# OPENAI_API_KEY=sk-...
# OPENAI_VOICE_POLISH_MODEL=gpt-4o-mini
# OPENAI_VISION_DAMAGE_MODEL=gpt-5.5-2026-04-23
# Use exact model id from platform.openai.com → Limits (e.g. gpt-5.5-2026-04-23, gpt-4o)
# gpt-4o-mini = cheaper but weaker on subtle scuffs / curb rash
# Set to false to disable OpenAI vision scan (Ravin can still run if configured)
# OPENAI_VISION_DAMAGE_ENABLED=true

# Damage detection provider: auto (OpenAI if configured, else Ravin), openai, or ravin
# DAMAGE_DETECTION_PROVIDER=openai
# Set to false to disable all automatic damage scans after photo upload
# DAMAGE_DETECTION_ENABLED=true

# Ravin AI — full inspection lifecycle (see lib/ravin/ and docs from Ravin partner pack)
# Inbound: otl = Ravin walkaround link | s3 = upload photos to Ravin ingest bucket
# RAVIN_INBOUND_MODE=s3
# Outbound: webhook = POST to your app | s3 = Ravin pushes JSON to your bucket prefix
# RAVIN_OUTBOUND_MODE=webhook
# Auth: art = Ravin API key (getSignInToken) | apt = partner token + validation callback
# RAVIN_AUTH_MODE=art
# RAVIN_API_BASE_URL=https://<provider-address-from-ravin>
# RAVIN_CLIENT_KEY=
# RAVIN_SITE_ID=
# RAVIN_PROVIDER=
# RAVIN_BRAND=Pre Delivery
# RAVIN_LINK_EXPIRED_HOURS=720
# RAVIN_LOGIN_EXPIRED_HOURS=72
# Webhook: register https://<APP_URL>/api/webhooks/ravin with Ravin
# RAVIN_WEBHOOK_SECRET=
# S3 inbound: presign endpoint from Ravin (Appendix C)
# RAVIN_S3_PRESIGN_URL=
# RAVIN_S3_INGEST_URL=https://ravin-eye-ingest.s3.amazonaws.com/
# S3 outbound: prefix in AWS_S3_BUCKET_NAME where Ravin drops JSON results
# RAVIN_S3_RESULTS_PREFIX=ravin-results/
# APT flow only — secret for HMAC partner tokens; callback URL /api/ravin/partner-validate
# RAVIN_PARTNER_TOKEN_SECRET=

# Ravin sync per-photo damage API (optional — separate from OTL/S3 lifecycle above)
# RAVIN_API_KEY=
# RAVIN_DAMAGE_API_URL=https://api.ravin.ai/your-endpoint
